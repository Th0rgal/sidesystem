#!/usr/bin/env bash
# sidesystem-connect — Cable-optional, fastest-link Razr SideSystem Superlink
# Automatically picks the fastest transport:
#   1. USB-C RNDIS / USB Ethernet (if USB tethering is active: ~0.3 ms UDP, ~1 Gbps)
#   2. Wi-Fi LAN (works completely cable-free! Auto-discovers via mDNS / cached IP / adb)
#
# Resolution priority:
#   --phone-res | --keep-res : keep the Razr's current phone resolution & aspect ratio
#   --mac-res                : sync Razr HEADLESS-1 to this Mac's focused monitor
#   (default)                : honor /var/lib/sidesystem/res-owner on the Razr
#                              ("phone" keeps phone resolution; "mac"/"auto" syncs to Mac)
# Pass --vnc for TigerVNC fallback.
set -euo pipefail
export PATH="/run/current-system/sw/bin:/etc/profiles/per-user/${USER:-thomas}/bin:${HOME}/.nix-profile/bin:${HOME}/.local/bin:${PATH:-/usr/bin:/bin}"

MODE="moonlight"
RES_MODE=""
POSITIONAL=()
while [ $# -gt 0 ]; do
    case "$1" in
        --vnc) MODE="vnc"; shift ;;
        --phone-res|--keep-res) RES_MODE="phone"; shift ;;
        --mac-res) RES_MODE="mac"; shift ;;
        *) POSITIONAL+=("$1"); shift ;;
    esac
done
set -- "${POSITIONAL[@]}"

IP_CACHE="${HOME}/.cache/sidesystem-razr-ip"
mkdir -p "${HOME}/.cache"
VNC_PORT="${VNC_PORT:-5900}"
LOCAL_PORT="${LOCAL_PORT:-5901}"
USE_ADB=0

if command -v adb >/dev/null 2>&1 && adb get-state >/dev/null 2>&1; then
    USE_ADB=1
fi

# Auto-detect focused host monitor resolution & scale (e.g. 2560x1600@60 scale=1.6)
MON_W=2560
MON_H=1600
MON_HZ=60
MON_SCALE="1.6"
if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    MON_JSON="$(hyprctl monitors -j 2>/dev/null || true)"
    if [ -n "$MON_JSON" ]; then
        parsed="$(printf '%s' "$MON_JSON" | jq -r '(.[] | select(.focused == true)) // .[0] | "\(.width) \(.height) \(.refreshRate | floor) \(.scale)"' 2>/dev/null || true)"
        if [ -n "$parsed" ]; then
            read -r MON_W MON_H MON_HZ MON_SCALE <<< "$parsed"
        fi
    fi
fi

# Pick the fastest reachable IP for Razr:
RAZR_IP="${1:-}"
LINK_KIND="Wi-Fi"

if [ -z "$RAZR_IP" ]; then
    usb_gw="$(ip -4 route show 2>/dev/null | awk '/dev (usb|enp.*u|rndis)/ && /via/ {print $3; exit}' || true)"
    if [ -n "$usb_gw" ] && timeout 0.5 bash -c "</dev/tcp/${usb_gw}/47989" 2>/dev/null; then
        RAZR_IP="$usb_gw"
        LINK_KIND="USB-C RNDIS"
    fi
fi

if [ -z "$RAZR_IP" ] && [ "$USE_ADB" -eq 1 ]; then
    adb_usb_ip="$(adb shell 'ip -4 addr show dev rndis0 2>/dev/null | sed -n "s/.*inet \([0-9.]*\)\/.*/\1/p" | head -n 1' 2>/dev/null | tr -d '\r\n ' || true)"
    if [ -n "$adb_usb_ip" ] && timeout 0.5 bash -c "</dev/tcp/${adb_usb_ip}/47989" 2>/dev/null; then
        RAZR_IP="$adb_usb_ip"
        LINK_KIND="USB-C RNDIS"
    else
        adb_wifi_ip="$(adb shell 'ip -4 addr show dev wlan0 2>/dev/null | sed -n "s/.*inet \([0-9.]*\)\/.*/\1/p" | head -n 1' 2>/dev/null | tr -d '\r\n ' || true)"
        if [ -n "$adb_wifi_ip" ]; then
            RAZR_IP="$adb_wifi_ip"
            printf '%s\n' "$RAZR_IP" > "$IP_CACHE"
            LINK_KIND="Wi-Fi (via adb)"
        fi
    fi
fi

if [ -z "$RAZR_IP" ]; then
    cached_ip="$(cat "$IP_CACHE" 2>/dev/null | tr -d '\r\n ' || true)"
    mdns_ip="$(getent ahostsv4 razr.local 2>/dev/null | awk 'NR==1{print $1}' || true)"
    for cand in "$cached_ip" "$mdns_ip" "192.168.1.185"; do
        [ -n "$cand" ] || continue
        if timeout 1 bash -c "</dev/tcp/${cand}/47989" 2>/dev/null || timeout 1 bash -c "</dev/tcp/${cand}/2222" 2>/dev/null; then
            RAZR_IP="$cand"
            printf '%s\n' "$RAZR_IP" > "$IP_CACHE"
            break
        fi
    done
    RAZR_IP="${RAZR_IP:-${cached_ip:-192.168.1.185}}"
fi

razr_exec() {
    local cmd="$1"
    local b64
    b64="$(printf '%s' "$cmd" | base64 -w0)"
    if [ "$USE_ADB" -eq 1 ]; then
        adb shell "su -c '/data/local/nixos/bin/droidspaces --name=razr run /run/current-system/sw/bin/bash -c \"printf %s ${b64} | base64 -d | /run/current-system/sw/bin/bash\"'" 2>/dev/null | tr -d '\r' || true
    else
        ssh -o ConnectTimeout=2 -o BatchMode=yes -p 2222 "thomas@${RAZR_IP}" \
            "printf %s '${b64}' | base64 -d | /run/current-system/sw/bin/bash" 2>/dev/null || true
    fi
}

if [ "$MODE" = "moonlight" ]; then
    # Start Sunshine + bt-hid-bridge on demand (works over USB adb OR cable-free Wi-Fi SSH)
    # and tear them down when Moonlight exits so libvirtualhid never keeps a fake keyboard/mouse
    # registered in Android when disconnected (also saves ~5% idle battery!).
    cleanup_sunshine() {
        if [ "$USE_ADB" -eq 1 ]; then
            adb shell 'su -c "killall bt-hid-bridge 2>/dev/null || true"' >/dev/null 2>&1 || true
        fi
        razr_exec 'pkill -9 -f "[s]unshine.conf" 2>/dev/null || true' >/dev/null 2>&1 || true
    }
    trap cleanup_sunshine EXIT INT TERM

    if ! timeout 1 bash -c "</dev/tcp/${RAZR_IP}/47989" 2>/dev/null; then
        echo "[sidesystem-connect] Starting Sunshine on demand..."
        if [ "$USE_ADB" -eq 1 ]; then
            # Start desktop if not running, then ensure sunshine is up
            if ! razr_exec 'pgrep -x Hyprland >/dev/null 2>&1 && echo OK' | grep -q OK; then
                adb shell "su -c '/data/local/nixos/bin/sidesystem-ctl desktop start ${MON_W}x${MON_H} 1.5 hw'" >/dev/null 2>&1 || true
            fi
        fi
        razr_exec '
if ! pgrep -f "[s]unshine.conf" >/dev/null 2>&1; then
    XDG_RT=/tmp/xdg-razr
    SIG=$(ls "$XDG_RT/hypr/" 2>/dev/null | head -n1)
    RUN_CMD="set -a; [ -f /tmp/xdg-razr/session.env ] && . /tmp/xdg-razr/session.env; set +a; export HOME=/home/thomas XDG_RUNTIME_DIR=\"$XDG_RT\" WAYLAND_DISPLAY=wayland-1 HYPRLAND_INSTANCE_SIGNATURE=\"$SIG\" PATH=/run/current-system/sw/bin:/etc/profiles/per-user/thomas/bin; setsid nohup sunshine /home/thomas/.config/sunshine/sunshine.conf >/tmp/sunshine.log 2>&1 </dev/null &"
    if [ "$(id -u)" -eq 0 ]; then
        runuser -u thomas -- /run/current-system/sw/bin/bash -c "$RUN_CMD"
    else
        /run/current-system/sw/bin/bash -c "$RUN_CMD"
    fi
fi' >/dev/null 2>&1 || true
        for _ in $(seq 1 25); do
            timeout 0.5 bash -c "</dev/tcp/${RAZR_IP}/47989" 2>/dev/null && break
            sleep 0.4
        done
    fi
    if [ "$USE_ADB" -eq 1 ]; then
        adb shell 'su -c "killall bt-hid-bridge 2>/dev/null || true; sleep 0.2; setsid /data/local/nixos/bin/bt-hid-bridge --sunshine 5900 >/data/local/nixos/sunshine-input.log 2>&1 </dev/null &"' </dev/null >/dev/null 2>&1 &
        sleep 0.3
    fi

    # Determine resolution priority: CLI flag overrides /var/lib/sidesystem/res-owner on Razr
    if [ -z "$RES_MODE" ]; then
        RES_MODE="$(razr_exec 'cat /var/lib/sidesystem/res-owner 2>/dev/null || echo auto' | tr -d ' \n')"
    fi

    STREAM_W="$MON_W"
    STREAM_H="$MON_H"

    if [ "$RES_MODE" = "phone" ]; then
        # Preserve the Razr's live phone resolution & aspect ratio so both screens mirror 1:1.
        # If HEADLESS-1 was left at a computer resolution (e.g. 2560x1600 / 1920x1080),
        # restore the Razr's native phone aspect ratio (2100x900 landscape or 900x2100 portrait).
        razr_exec 'mkdir -p /var/lib/sidesystem && printf "phone\n" > /var/lib/sidesystem/res-owner 2>/dev/null || true' >/dev/null 2>&1 || true
        cur_mon="$(razr_exec 'XDG_RT=/tmp/xdg-razr; SIG=$(ls "$XDG_RT/hypr/" 2>/dev/null | head -n1); [ -n "$SIG" ] && XDG_RUNTIME_DIR="$XDG_RT" HYPRLAND_INSTANCE_SIGNATURE="$SIG" /run/current-system/sw/bin/hyprctl monitors -j 2>/dev/null | /run/current-system/sw/bin/jq -r ".[0] | \"\(.width) \(.height)\""' | tail -n 1)"
        cw=0; ch=0
        if [ -n "$cur_mon" ]; then
            read -r cw ch <<< "$cur_mon"
        fi
        # Check whether current HEADLESS-1 is a computer aspect ratio (1.25..1.85) instead of phone (~2.33 or ~0.43)
        is_computer_ar=0
        if [[ "${cw:-0}" =~ ^[0-9]+$ ]] && [[ "${ch:-0}" =~ ^[0-9]+$ ]] && [ "$cw" -ge 320 ] && [ "$ch" -ge 320 ]; then
            ratio_x100=$(( cw * 100 / ch ))
            if [ "$ratio_x100" -ge 125 ] && [ "$ratio_x100" -le 185 ]; then
                is_computer_ar=1
            fi
        else
            is_computer_ar=1
        fi
        if [ "$is_computer_ar" -eq 1 ]; then
            # Detect phone orientation via adb if connected (rotation 1/3 = landscape, 0/2 = portrait)
            phone_w=2100
            phone_h=900
            if [ "$USE_ADB" -eq 1 ]; then
                rot="$(adb shell 'dumpsys input 2>/dev/null | grep -m1 "SurfaceOrientation:" | awk "{print \$2}"' 2>/dev/null | tr -d '\r\n ' || true)"
                if [ "$rot" = "0" ] || [ "$rot" = "2" ]; then
                    phone_w=900
                    phone_h=2100
                fi
            fi
            STREAM_W="$phone_w"
            STREAM_H="$phone_h"
            razr_exec "
RUN_CMD='set -a; . /tmp/xdg-razr/session.env; set +a; /run/current-system/sw/bin/hyprctl eval \"hl.monitor({ output = \\\"HEADLESS-1\\\", mode = \\\"${STREAM_W}x${STREAM_H}@60\\\", position = \\\"0x0\\\", scale = \\\"1.5\\\" })\" >/dev/null 2>&1'
if [ \"\$(id -u)\" -eq 0 ]; then
    runuser -u thomas -- /run/current-system/sw/bin/bash -c \"\$RUN_CMD\"
else
    /run/current-system/sw/bin/bash -c \"\$RUN_CMD\"
fi" >/dev/null 2>&1 || true
            sleep 0.3
        else
            STREAM_W="$cw"
            STREAM_H="$ch"
        fi
        echo "[sidesystem-connect] Resolution priority: PHONE (mirroring ${STREAM_W}x${STREAM_H}@${MON_HZ})"
    else
        # Computer takes resolution priority: sync HEADLESS-1 to Mac's focused monitor
        razr_exec "
RUN_CMD='set -a; . /tmp/xdg-razr/session.env; set +a; /run/current-system/sw/bin/hyprctl eval \"hl.monitor({ output = \\\"HEADLESS-1\\\", mode = \\\"${MON_W}x${MON_H}@${MON_HZ}\\\", position = \\\"0x0\\\", scale = \\\"${MON_SCALE}\\\" })\" >/dev/null 2>&1'
if [ \"\$(id -u)\" -eq 0 ]; then
    runuser -u thomas -- /run/current-system/sw/bin/bash -c \"\$RUN_CMD\"
else
    /run/current-system/sw/bin/bash -c \"\$RUN_CMD\"
fi" >/dev/null 2>&1 || true
        echo "[sidesystem-connect] Resolution priority: MAC (${STREAM_W}x${STREAM_H}@${MON_HZ})"
    fi

    echo "[sidesystem-connect] Launching Moonlight UDP over ${LINK_KIND} (${RAZR_IP}, ${STREAM_W}x${STREAM_H}@${MON_HZ}, 60 Mbps)..."
    ML_ARGS=(
        stream "$RAZR_IP" "Desktop"
        --resolution "${STREAM_W}x${STREAM_H}"
        --fps "$MON_HZ"
        --bitrate 60000
        --video-decoder software
        --display-mode windowed
        --absolute-mouse
        --no-vsync
        --no-frame-pacing
    )
    if command -v moonlight >/dev/null 2>&1; then
        moonlight "${ML_ARGS[@]}"
    elif [ -x /nix/store/j5b76lij5nhyv6hz6i2kpwimzfki4y4l-moonlight-qt-6.2.0/bin/moonlight ]; then
        /nix/store/j5b76lij5nhyv6hz6i2kpwimzfki4y4l-moonlight-qt-6.2.0/bin/moonlight "${ML_ARGS[@]}"
    elif command -v nix >/dev/null 2>&1; then
        nix run nixpkgs#moonlight-qt -- "${ML_ARGS[@]}"
    else
        echo "ERROR: moonlight not found." >&2
        exit 1
    fi
    exit $?
fi

# --- VNC fallback (--vnc) ---
TARGET_HOST="${RAZR_IP}:${VNC_PORT}"
if [ "$USE_ADB" -eq 1 ]; then
    adb forward "tcp:${LOCAL_PORT}" "tcp:${VNC_PORT}" >/dev/null
    TARGET_HOST="127.0.0.1:${LOCAL_PORT}"
fi
VNC_ARGS=(-RemoteResize=0 -Shared=1 -FullscreenSystemKeys=1 -PreferredEncoding=Tight -CompressLevel=1 -QualityLevel=9)
if command -v vncviewer >/dev/null 2>&1; then
    exec vncviewer "${VNC_ARGS[@]}" "$TARGET_HOST"
else
    exec nix run nixpkgs#tigervnc -- "${VNC_ARGS[@]}" "$TARGET_HOST"
fi
