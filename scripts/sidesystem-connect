#!/usr/bin/env bash
# sidesystem-connect — One-command Mac/Linux <-> Razr SideSystem Superlink
# 1. Auto-detects USB-C adb (~0.3 ms RTT via adb forward) or falls back to Wi-Fi IP
# 2. Launches TigerVNC (rock-solid, zero tile artifacts)
# 3. Live-syncs Razr HEADLESS-1 resolution to match the exact VNC window size
#    whenever you tile, resize, or press Option+F (fullscreen + passthrough)
set -euo pipefail
export PATH="/run/current-system/sw/bin:/etc/profiles/per-user/${USER:-thomas}/bin:${HOME}/.nix-profile/bin:${HOME}/.local/bin:${PATH:-/usr/bin:/bin}"

VNC_PORT="${VNC_PORT:-5900}"
LOCAL_PORT="${LOCAL_PORT:-5901}"
TARGET_HOST=""
USE_ADB=0

if command -v adb >/dev/null 2>&1 && adb get-state >/dev/null 2>&1; then
    USE_ADB=1
    echo "[sidesystem-connect] USB-C adb detected — forwarding tcp:${LOCAL_PORT} -> tcp:${VNC_PORT} (~0.3 ms RTT)"
    adb forward "tcp:${LOCAL_PORT}" "tcp:${VNC_PORT}" >/dev/null
    TARGET_HOST="127.0.0.1:${LOCAL_PORT}"
else
    RAZR_IP="${1:-192.168.1.185}"
    echo "[sidesystem-connect] No USB adb — connecting over Wi-Fi to ${RAZR_IP}:${VNC_PORT}"
    TARGET_HOST="${RAZR_IP}:${VNC_PORT}"
fi

# Live window-size syncer: watches Vncviewer geometry + monitor scale on host Hyprland
# and resizes Razr HEADLESS-1 to exact physical pixels (size * monitor_scale) with matching DPI scale
# whenever the window opens, tiles, resizes, or toggles Option+F fullscreen.
resize_razr() {
    local w="$1" h="$2" s="$3"
    [ "$USE_ADB" -eq 1 ] || return 0
    # Clamp to sane even dimensions
    w=$(( (w / 2) * 2 ))
    h=$(( (h / 2) * 2 ))
    [ "$w" -ge 320 ] && [ "$h" -ge 240 ] || return 0
    adb shell "su -c '/data/local/nixos/bin/droidspaces --name=razr run /bin/sh -c \"su -s /bin/sh - thomas -c '\''set -a; . /tmp/xdg-razr/session.env; set +a; /run/current-system/sw/bin/hyprctl eval \\\"hl.monitor({ output = \\\\\\\"HEADLESS-1\\\\\\\", mode = \\\\\\\"${w}x${h}@60\\\\\\\", position = \\\\\\\"0x0\\\\\\\", scale = \\\\\\\"${s}\\\\\\\" })\\\" >/dev/null 2>&1'\''\"'" >/dev/null 2>&1 || true
}

start_resize_watcher() {
    local vnc_pid="$1"
    [ "$USE_ADB" -eq 1 ] || return 0
    command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 0
    (
        last_sz=""
        while kill -0 "$vnc_pid" 2>/dev/null; do
            mons="$(hyprctl monitors -j 2>/dev/null || echo '[]')"
            sz="$(hyprctl clients -j 2>/dev/null | jq -r --argjson mons "$mons" '
                (.[] | select((.class | ascii_downcase | contains("vnc")) or (.title | ascii_downcase | contains("tigervnc")))) as $c
                | ($mons[] | select(.id == $c.monitor) | .scale) as $s
                | "\(($c.size[0] * $s) | round) \(($c.size[1] * $s) | round) \($s)"
            ' 2>/dev/null | head -n 1 || true)"
            if [ -n "$sz" ] && [ "$sz" != "$last_sz" ]; then
                last_sz="$sz"
                read -r w h s <<< "$sz"
                resize_razr "$w" "$h" "$s"
            fi
            sleep 0.25
        done
    ) >/dev/null 2>&1 &
}

VNC_ARGS=(-RemoteResize=0 -Shared=1 -FullscreenSystemKeys=1 -PreferredEncoding=Tight -CompressLevel=1 -QualityLevel=9)

if command -v vncviewer >/dev/null 2>&1; then
    vncviewer "${VNC_ARGS[@]}" "$TARGET_HOST" &
    VPID=$!
elif command -v nix >/dev/null 2>&1; then
    nix run nixpkgs#tigervnc -- "${VNC_ARGS[@]}" "$TARGET_HOST" &
    VPID=$!
else
    echo "ERROR: No VNC viewer found (install tigervnc). Target ready at ${TARGET_HOST}" >&2
    exit 1
fi

start_resize_watcher "$VPID"
wait "$VPID"
